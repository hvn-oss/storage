{
  "$schema": "https://json.schemastore.org/package",
  "name": "@hvn-oss/storage-react",
  "version": "0.0.0",
  "description": "React bindings for HVN Storage.",
  "homepage": "https://github.com/hvn-oss/storage#readme",
  "bugs": {
    "url": "https://github.com/hvn-oss/storage/issues"
  },
  "license": "MIT",
  "author": "Daniel Fakunle <danielofakunle@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "github:hvn-oss/storage",
    "directory": "packages/storage-react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "git clean -fdx node_modules dist .output",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@hvn-oss/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "react": "^19.2.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

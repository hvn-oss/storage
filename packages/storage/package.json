{
  "$schema": "https://json.schemastore.org/package",
  "name": "@hvn-oss/storage",
  "version": "0.0.0",
  "description": "Direct-to-cloud file transfer contracts and runtime adapters.",
  "homepage": "https://github.com/hvn-oss/storage#readme",
  "bugs": {
    "url": "https://github.com/hvn-oss/storage/issues"
  },
  "license": "MIT",
  "author": "Daniel Fakunle <danielofakunle@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "github:hvn-oss/storage",
    "directory": "packages/storage"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./browser": "./dist/browser.mjs",
    "./browser/effect": "./dist/browser/effect.mjs",
    "./persistence/effect": "./dist/persistence/effect.mjs",
    "./s3": "./dist/s3.mjs",
    "./s3/effect": "./dist/s3/effect.mjs",
    "./server": "./dist/server.mjs",
    "./server/effect": "./dist/server/effect.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "clean": "git clean -fdx node_modules dist .output",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@hvn-oss/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

{
  "name": "hvn-storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run docs#dev",
    "clean": "vp run -r clean && git clean -fdx node_modules dist .output",
    "prepare": "vp config && effect-tsgo patch --typescript"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/tsgo": "catalog:",
    "@hvn-oss/tsconfig": "catalog:",
    "effect-solutions": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

{
  "name": "hvn-storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run website#dev",
    "typecheck": "vp run -r typecheck",
    "prepare": "vp config && effect-tsgo patch --typescript"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "effect-solutions": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
